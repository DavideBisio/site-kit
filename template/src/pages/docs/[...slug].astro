---
import { getCollection, render } from 'astro:content';
import { DocsLayout, withBase } from '@davidebisio/site-kit';
import { docsNav, docTitle, editLink } from '@davidebisio/site-kit/content';
import config from 'virtual:site-kit/config';

export async function getStaticPaths() {
  const entries = await getCollection('docs', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const nav = docsNav(await getCollection('docs'), (e) => withBase(`/docs/${e.id}/`));

// Markdown reused from a repo's docs/ usually starts with its own "# Title".
const hasOwnH1 = headings.some((h) => h.depth === 1);
const editUrl = config.repo ? editLink(config.repo, entry.filePath, { siteDir: '{{siteDir}}' }) : undefined;
---

<DocsLayout
  title={docTitle(entry)}
  description={entry.data.description}
  nav={nav}
  headings={headings}
  showTitle={!hasOwnH1}
  editUrl={editUrl}
>
  <Content />
</DocsLayout>
