---
// A left-to-right pipeline of steps (stacks vertically on phones). Ported from davidebisio.github.io.
import { formatInline } from '../../lib/inline.js';

interface Step {
  label: string;
  code: string;
  body: string;
}

interface Props {
  caption?: string;
  steps: Step[];
}

const { caption, steps } = Astro.props;
---

<div class="sk-flow">
  {caption && <p class="caption" set:html={formatInline(caption)} />}
  <div class="row">
    {
      steps.map((step, i) => (
        <>
          <div class="step">
            <div class="label">
              {i + 1} &middot; {step.label}
            </div>
            <div class="code">
              <code>{step.code}</code>
            </div>
            <p set:html={formatInline(step.body)} />
          </div>
          {i < steps.length - 1 && (
            <div class="arrow" aria-hidden="true">
              &rarr;
            </div>
          )}
        </>
      ))
    }
  </div>
</div>

<style>
  @layer site-kit {
    .sk-flow {
      margin: var(--sk-space-5) 0;
    }
    .caption {
      margin: 0 0 var(--sk-space-3);
      color: var(--sk-muted);
      font-size: var(--sk-text-sm);
    }
    .row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sk-space-2);
    }
    @media (min-width: 640px) {
      .row {
        flex-direction: row;
      }
    }
    .step {
      flex: 1;
      padding: var(--sk-space-4);
      border: 1px solid var(--sk-line);
      border-radius: var(--sk-radius);
      background: var(--sk-surface);
    }
    .label {
      color: var(--sk-link);
      font-size: var(--sk-text-xs);
      font-weight: 600;
    }
    .code {
      margin-top: var(--sk-space-1);
      font-size: var(--sk-text-sm);
    }
    p {
      margin: var(--sk-space-1) 0 0;
      color: var(--sk-muted);
      font-size: var(--sk-text-sm);
    }
    .arrow {
      display: grid;
      place-items: center;
      color: var(--sk-muted);
      font-size: var(--sk-text-lg);
      transform: rotate(90deg);
    }
    @media (min-width: 640px) {
      .arrow {
        transform: none;
      }
    }
  }
</style>
