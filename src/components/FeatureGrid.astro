---
// Responsive grid of feature cards. `body` accepts `code`, **bold** and [links](…).
//   <FeatureGrid items={[{ title: 'Offline', body: 'Nothing leaves your browser.', icon: '🔒' }]} />
import { formatInline } from '../lib/inline.js';
import { withBase } from '../lib/url.js';

interface Item {
  title: string;
  body?: string;
  /** A short glyph or emoji. */
  icon?: string;
  href?: string;
}

interface Props {
  items: Item[];
  /** Minimum card width before wrapping. */
  min?: string;
}

const { items, min = '13rem' } = Astro.props;
---

<ul class="sk-features" style={`--min: ${min}`}>
  {
    items.map((item) => (
      <li class="card">
        {item.icon && <span class="icon" aria-hidden="true">{item.icon}</span>}
        <h3>{item.href ? <a href={withBase(item.href)}>{item.title}</a> : item.title}</h3>
        {item.body && <p set:html={formatInline(item.body)} />}
      </li>
    ))
  }
</ul>

<style>
  @layer site-kit {
    .sk-features {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--min)), 1fr));
      gap: var(--sk-space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .card {
      position: relative;
      padding: var(--sk-space-5);
      border: 1px solid var(--sk-line);
      border-radius: var(--sk-radius);
      background: var(--sk-surface);
    }
    .icon {
      display: inline-grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      margin-bottom: var(--sk-space-3);
      border-radius: var(--sk-radius);
      background: var(--sk-surface-2);
      font-size: 1.1rem;
    }
    h3 {
      margin: 0 0 var(--sk-space-2);
      font-size: var(--sk-text-md);
    }
    h3 a {
      color: inherit;
      text-decoration: none;
    }
    h3 a::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .card:has(a):hover {
      border-color: var(--sk-link);
    }
    p {
      margin: 0;
      color: var(--sk-muted);
      font-size: var(--sk-text-sm);
    }
  }
</style>
