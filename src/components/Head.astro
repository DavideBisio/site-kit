---
import config from 'virtual:site-kit/config';
import ThemeScript from './ThemeScript.astro';
import { withBase } from '../lib/url.js';

export interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  /** Site-relative or absolute URL of a social preview image. */
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const { title, description = config.description, type = 'website', image, noindex = false, structuredData } = Astro.props;

const siteName = config.title;
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site ? new URL(withBase(image), Astro.site).href : undefined;

// Built-in mark: a monogram on a crimson tile, so a new project has a favicon on day one.
const initials = config.owner.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const defaultIcon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#c84b42"/><text x="32" y="42" font-family="system-ui,sans-serif" font-size="28" font-weight="700" text-anchor="middle" fill="#f2ede4">${initials}</text></svg>`,
  );
const favicon = config.favicon ? withBase(config.favicon) : defaultIcon;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<ThemeScript />
<title>{pageTitle}</title>
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content={config.themeColor} />
<link rel="icon" href={favicon} />
<meta name="generator" content={Astro.generator} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={pageTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={type} />
{canonical && <meta property="og:url" content={canonical} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
{
  config.analytics.goatcounter && (
    <script
      is:inline
      data-goatcounter={`https://${config.analytics.goatcounter}.goatcounter.com/count`}
      async
      src="https://gc.zgo.at/count.js"
    />
  )
}
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
