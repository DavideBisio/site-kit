---
// Sets <html data-theme> before first paint (no flash). Same logic and storage key as
// <site-bar>, so a choice made on any *.github.io project site carries to the others.
---

<script is:inline>
  (function () {
    var t;
    try {
      t = localStorage.getItem('theme');
    } catch (e) {}
    if (t !== 'light' && t !== 'dark') {
      t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.dataset.theme = t;
  })();
</script>
