---
import config from 'virtual:site-kit/config';
import ThemeToggle from './ThemeToggle.astro';
import { withBase, isActive, isExternal } from '../lib/url.js';

interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;

const items = config.nav.map((item) => {
  const href = withBase(item.href);
  return { ...item, href, external: isExternal(href), active: isActive(Astro.url.pathname, href) };
});
const home = withBase('/');
// The logo sits inside the owner link, as on the hub, so it also leads home.
const logo = config.logo ? withBase(config.logo) : null;
---

<header class="sk-header">
  <nav class="sk-container sk-header-inner" data-wide={wide || undefined} aria-label="Main">
    <div class="brand">
      {
        config.hub ? (
          <a href={home} class="owner">
            {logo && <img src={logo} alt="" width="48" height="36" class="logo" />}
            {config.owner.name}
          </a>
        ) : (
          <>
            <a href={config.owner.url} class="owner dim">
              {logo && <img src={logo} alt="" width="48" height="36" class="logo" />}
              {config.owner.name}
            </a>
            <span class="sep" aria-hidden="true">/</span>
            <a href={home} class="project">{config.title}</a>
          </>
        )
      }
    </div>
    <ul class="links">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      {
        config.repo && (
          <li>
            <a href={config.repo} target="_blank" rel="noopener noreferrer">
              Source
            </a>
          </li>
        )
      }
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>

<style>
  @layer site-kit {
    .sk-header {
      border-bottom: 1px solid var(--sk-line);
    }
    .sk-header-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--sk-space-2) var(--sk-space-5);
      padding-block: var(--sk-space-4);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: var(--sk-space-2);
      min-width: 0;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .brand a {
      color: inherit;
      text-decoration: none;
    }
    .owner {
      display: flex;
      align-items: center;
      gap: var(--sk-space-3);
    }
    .brand a:hover {
      color: var(--sk-link);
    }
    .logo {
      width: auto;
      height: 2.25rem;
      border-radius: var(--sk-radius-md);
    }
    .owner.dim {
      color: var(--sk-muted);
      font-weight: 500;
    }
    .sep {
      color: var(--sk-muted);
    }
    .links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sk-space-1) var(--sk-space-5);
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: var(--sk-text-sm);
    }
    .links a {
      color: var(--sk-muted);
      text-decoration: none;
      padding-block: var(--sk-space-2);
    }
    .links a:hover,
    .links a[aria-current='page'] {
      color: var(--sk-link);
    }
    .links a[aria-current='page'] {
      font-weight: 500;
    }
  }
</style>
