{
  "name": "@davidebisio/site-kit",
  "version": "0.1.2",
  "description": "Shared design tokens, Astro components and scaffolding for Davide Bisio's project sites.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideBisio/site-kit.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "site-kit": "./scripts/cli.mjs"
  },
  "files": [
    "src",
    "template",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./integration": {
      "types": "./src/integration.d.ts",
      "default": "./src/integration.js"
    },
    "./content": {
      "types": "./src/lib/content.d.ts",
      "default": "./src/lib/content.js"
    },
    "./projects": {
      "types": "./src/lib/projects.d.ts",
      "default": "./src/lib/projects.js"
    },
    "./url": {
      "types": "./src/lib/url.d.ts",
      "default": "./src/lib/url.js"
    },
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*",
    "./elements/site-bar.js": "./src/elements/site-bar.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "devDependencies": {
    "astro": "^7.4.1"
  },
  "keywords": [
    "astro-component",
    "astro-integration"
  ]
}
